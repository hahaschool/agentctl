# AgentCTL Mesh Node Configuration Template
#
# Copy to .env.mesh and fill in values, or run:
#   ./scripts/setup-mesh-node.sh
# to generate automatically.

TIER=mesh
MACHINE_ID=
DATABASE_URL=postgresql://user@127.0.0.1:5432/agentctl_mesh
REDIS_URL=redis://localhost:6379/0
PORT=8080
WORKER_PORT=9000
CONTROL_PLANE_URL=http://localhost:8080
CONTROL_URL=http://localhost:8080
TAILSCALE_IP=
NODE_ENV=production

# Shared bootstrap token for mesh peer reverse-registration.
#
# When you run `POST /api/sync/peers` on any node to add a peer, the control
# plane calls the remote node's `/api/sync/peers/register-reverse` with this
# token so it auto-registers the caller without a manual curl. Every node in
# the fleet MUST share the same value — generate once and copy to each
# machine's `.env.mesh`:
#
#   openssl rand -hex 32
#
# If this is unset, adding a peer still works on the local side but the remote
# node rejects reverse-registration with 503 PEER_REGISTRATION_DISABLED and
# you must add the reverse row manually on each machine. `setup-mesh-node.sh`
# will generate one automatically if `.env.mesh` doesn't already carry it.
SYNC_PEER_REGISTRATION_TOKEN=

# Uncomment and set if you use encrypted API credentials:
# CREDENTIAL_ENCRYPTION_KEY=

# Uncomment to skip auto-migrations (if run separately):
# SKIP_MIGRATIONS=true
